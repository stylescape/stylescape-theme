{
  "name": "stylescape_npm",
  "version": "0.1.0",
  "description": "The brand-neutral starter theme for the Stylescape design system — the template a new brand theme is copied from. Its placeholder palette is stylescape core's own defaults as --ss-* token overrides, with a dark variant for whole pages or single bands and the system font stacks.",
  "keywords": [
    "stylescape",
    "theme",
    "template",
    "starter",
    "design-tokens",
    "sass",
    "scss",
    "css"
  ],
  "homepage": "https://github.com/stylescape/stylescape-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stylescape/stylescape-theme.git"
  },
  "bugs": {
    "url": "https://github.com/stylescape/stylescape-theme/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lars Bastiaan van Vianen",
    "email": "lars@scape.agency"
  },
  "private": true,
  "type": "module",
  "main": "src/scss/index.scss",
  "sass": "src/scss/index.scss",
  "style": "src/scss/index.scss",
  "exports": {
    ".": {
      "sass": "./src/scss/index.scss",
      "style": "./src/scss/index.scss",
      "default": "./src/scss/index.scss"
    },
    "./abstracts": {
      "sass": "./src/scss/abstracts/_index.scss"
    },
    "./tokens": {
      "sass": "./src/scss/tokens/_index.scss"
    },
    "./themes": {
      "sass": "./src/scss/themes/_index.scss"
    },
    "./base": {
      "sass": "./src/scss/base/_index.scss"
    },
    "./font/*": {
      "style": "./src/font/*",
      "default": "./src/font/*"
    },
    "./src/font/*": {
      "style": "./src/font/*",
      "default": "./src/font/*"
    },
    "./css": {
      "style": "./dist/css/ss.css",
      "default": "./dist/css/ss.css"
    },
    "./css/min": {
      "style": "./dist/css/ss.min.css",
      "default": "./dist/css/ss.min.css"
    },
    "./scss/*": "./src/scss/*",
    "./src/scss/*": "./src/scss/*",
    "./stylelint": "./stylelint.config.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/css/**/*.{css,map}",
    "src/scss/**/*.scss",
    "src/font/**/*.{css,woff2,txt}",
    "stylelint.config.mjs",
    "doc/**/*.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && NO_EMPTY=1 MINIFY=1 vite build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "node --test tst/*.test.mjs",
    "format": "prettier . --check",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "clean": "rm -rf dist .vite coverage",
    "prepublishOnly": "npm run check && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=tst/helpers.mjs --test-coverage-include=stylelint.config.mjs --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=80 tst/*.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "sass": "^1.93.0",
    "stylescape": ">=0.5.1"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": false
    },
    "stylescape": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/web-components-vite": "^10.6.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lit": "^3.3.3",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "storybook": "^10.6.1",
    "stylescape": "^0.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
